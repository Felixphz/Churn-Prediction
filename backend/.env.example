# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/churn_prediction
# Labeled outcomes for retraining (separate Neon project in production)
TRAINING_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/churn_training
DB_USER=user
DB_PASSWORD=password

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
REGISTRY_MODEL_NAME=churn-model
MODEL_ALIAS=production

# API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Model
MODEL_THRESHOLD=0.30
DEFAULT_MODEL=LogisticRegression

# Retrain
RETRAIN_MIN_IMPROVEMENT=0.01
TOP_K_MODELS=5
RETRAIN_SERVICE_URL=http://localhost:8001
RETRAIN_INCLUDE_TREATED=false
RETRAIN_MIN_SAMPLES=500

# Production retrain on GitHub Actions (empty -> RETRAIN_SERVICE_URL)
GITHUB_TOKEN=
GITHUB_REPO=Felixphz/Churn-Prediction
